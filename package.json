{
  "name": "mobile-automation-final-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Android mobile automation foundation using WebdriverIO and Appium.",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "apk:download": "node scripts/download-apk.mjs",
    "appium:check": "node scripts/check-appium-driver.mjs",
    "appium:install": "node scripts/install-appium-driver.mjs",
    "check:solution": "node scripts/check-solution.mjs",
    "quality": "npm run check:solution && npm run typecheck && npm run appium:check",
    "test": "wdio run ./config/wdio.conf.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@wdio/appium-service": "9.31.9",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/types": "9.31.2",
    "@types/mocha": "10.0.10",
    "@types/node": "26.5.1",
    "appium": "3.7.0",
    "appium-uiautomator2-driver": "8.7.0",
    "mocha": "11.7.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "webdriverio": "9.31.9"
  }
}
